{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "PLLRelease",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PLL_KEEP_DEBUG_SYMBOLS": "ON",
                "PLL_ENABLE_RTT": "ON",
                "PLL_AUTO_RUN_ENCODER": "OFF",
                "PLL_DIRECT_SENSORLESS": "ON",
                "CMAKE_C_FLAGS_RELEASE": "-O2 -g3",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -g3"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "PLLRelease",
            "configurePreset": "PLLRelease"
        }
    ]
}
